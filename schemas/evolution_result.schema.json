{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question Evolution Result",
  "type": "object",
  "additionalProperties": true,
  "required": ["evolved_prompt"],
  "properties": {
    "evolved_prompt": {
      "type": "string",
      "minLength": 1
    },
    "evolution_strategy": {
      "type": "string"
    },
    "ability_axis": {
      "type": "string"
    },
    "operator_envelope": {
      "$ref": "operator_envelope.schema.json"
    },
    "target_claim": {},
    "conclusion_layer": {
      "type": "string"
    },
    "surface_fact_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "applied_transforms": {
      "type": "array",
      "items": {"type": "string"}
    },
    "operator_payload": {
      "type": "object",
      "additionalProperties": true
    },
    "surface_leakage_risks": {
      "type": ["object", "array"]
    },
    "answer_contract": {
      "type": "object",
      "additionalProperties": true
    },
    "answer_contract_resolution": {
      "type": "object",
      "additionalProperties": true
    },
    "target_subclaim": {
      "type": "string"
    },
    "boundary_hypothesis": {
      "type": "string"
    },
    "expected_qwen_failure": {
      "type": "string"
    },
    "expected_evaluation_focus": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes_for_reference": {
      "type": "string"
    },
    "question_evolution_raw_response": {
      "type": "string"
    }
  }
}
