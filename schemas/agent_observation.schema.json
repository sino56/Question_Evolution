{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question Evolution Agent Observation",
  "type": "object",
  "required": ["experiment_dir", "status", "final_records_count", "pending_count", "boundary_candidate_count", "score_increased_count", "not_applicable_count", "validation_failed_count", "branch_error_count", "target_reached", "missing_artifacts", "evidence_refs"],
  "properties": {
    "experiment_dir": {"type": "string"},
    "status": {"enum": ["observed", "blocked"]},
    "manifest_status": {"enum": ["ok", "not_checked", "damaged"]},
    "termination_reason": {"type": ["string", "null"], "examples": ["manual_review_required", "review_completed", "no_pending_branches", "effective_boundary_found", "judge_instability", "retryable_tool_failure", "unrecoverable_tool_failure", "manifest_corrupted", "artifact_blocked", "configuration_error", "dry_run_completed", "invalid_plan", "memory_snapshot_unavailable", "replan_pending_execution", "budget_exhausted", "evaluation_budget_exhausted", "generation_budget_exhausted", "max_search_steps_budget_exhausted", "request_budget_exhausted", "scoring_budget_exhausted", "search_budget_exhausted"], "description": "Documented terminal reasons. The type stays open because a pipeline stage may report its own reason; every BUDGET_TERMINAL_REASONS entry must appear in this list (asserted by tests/test_agent_contract_drift.py)."},
    "judge_stability": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"enum": ["stable", "unstable", "not_reported"]}},
      "additionalProperties": true
    },
    "final_records_count": {"type": "integer", "minimum": 0},
    "pending_count": {"type": "integer", "minimum": 0},
    "boundary_candidate_count": {"type": "integer", "minimum": 0},
    "score_increased_count": {"type": "integer", "minimum": 0},
    "not_applicable_count": {"type": "integer", "minimum": 0},
    "validation_failed_count": {"type": "integer", "minimum": 0},
    "branch_error_count": {"type": "integer", "minimum": 0},
    "target_reached": {"type": "boolean"},
    "missing_artifacts": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "object"}},
    "observations": {"type": "array", "items": {"$ref": "agent_normalized_observation.schema.json"}}
  },
  "additionalProperties": true
}
