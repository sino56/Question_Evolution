{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question Evolution Metadata",
  "type": "object",
  "additionalProperties": true,
  "required": ["question_evolved"],
  "properties": {
    "question_evolved": {
      "type": "boolean"
    },
    "trigger_score_rate": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "question_evolution_model": {
      "type": "string"
    },
    "operator_used": {
      "type": "string"
    },
    "ability_axis": {
      "type": "string"
    },
    "semantic_version": {
      "type": "string"
    },
    "prompt_version": {
      "type": "string"
    },
    "applicability_version": {
      "type": "string"
    },
    "validation_policy_version": {
      "type": "string"
    },
    "recipe_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_status": {
      "type": "string"
    },
    "target_claim": {},
    "conclusion_layer": {
      "type": "string"
    },
    "surface_fact_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "applied_transforms": {
      "type": "array",
      "items": {"type": "string"}
    },
    "target_error_taxonomy": {
      "type": "array",
      "items": {"type": "string"}
    },
    "required_reasoning_output": {
      "type": "array",
      "items": {"type": "string"}
    },
    "preserved_parent_obligations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "operator_payload": {
      "type": "object",
      "additionalProperties": true
    },
    "surface_leakage_risks": {
      "type": ["object", "array"]
    },
    "answer_contract": {
      "type": "object",
      "additionalProperties": true
    },
    "answer_contract_resolution": {
      "type": "object",
      "additionalProperties": true
    },
    "operator_envelope": {
      "$ref": "operator_envelope.schema.json"
    },
    "target_subclaim": {
      "type": "string"
    },
    "boundary_hypothesis": {
      "type": "string"
    },
    "expected_qwen_failure": {
      "type": "string"
    },
    "expected_evaluation_focus": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evolution_strategy": {
      "type": "string"
    },
    "notes_for_reference": {
      "type": "string"
    },
    "question_evolution_raw_response": {
      "type": "string",
      "deprecated": true,
      "description": "Legacy inline trace retained only for historical-record compatibility."
    },
    "question_evolution_raw_response_trace_id": {
      "type": "string",
      "description": "Trace ID for the raw response stored in the gzip sidecar registered by the artifact manifest."
    },
    "complexity_budget": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
