{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validation Result",
  "type": "object",
  "additionalProperties": true,
  "required": ["passed"],
  "properties": {
    "passed": {
      "type": "boolean"
    },
    "main_axis_count": {
      "type": "integer",
      "minimum": 0
    },
    "new_facts_count": {
      "type": "integer",
      "minimum": 0
    },
    "output_tasks_count": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_options_count": {
      "type": "integer",
      "minimum": 0
    },
    "counterfactual_count": {
      "type": "integer",
      "minimum": 0
    },
    "estimated_prompt_chars": {
      "type": "integer",
      "minimum": 0
    },
    "prompt_char_delta": {
      "type": ["integer", "null"]
    },
    "prompt_char_growth_ratio": {
      "type": ["number", "null"]
    },
    "semantic_economy_mode": {
      "enum": ["off", "shadow", "enforce"]
    },
    "semantic_economy_evaluated": {
      "type": "boolean"
    },
    "semantic_economy_llm_evaluated": {
      "type": "boolean"
    },
    "semantic_economy_llm_status": {
      "type": "string"
    },
    "semantic_economy_risk": {
      "enum": ["low", "medium", "high", "not_evaluated", "unassessed"]
    },
    "semantic_redundancy_dominant": {
      "type": ["boolean", "null"]
    },
    "shared_context_repeated": {
      "type": ["boolean", "null"]
    },
    "answer_hint_expansion": {
      "type": ["boolean", "null"]
    },
    "surface_leak_risk": {
      "type": ["boolean", "null"]
    },
    "surface_leak_type": {
      "type": "array",
      "items": {"type": "string"}
    },
    "semantic_economy_evidence": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true}
    },
    "suggested_same_operator_retry_reason": {
      "type": ["string", "null"]
    },
    "external_knowledge_risk": {
      "enum": ["low", "medium", "high"]
    },
    "format_difficulty_risk": {
      "enum": ["low", "medium", "high"]
    },
    "repeat_pattern_risk": {
      "enum": ["low", "medium", "high"]
    },
    "why_passed": {
      "type": "string"
    },
    "reject_reason": {
      "type": ["string", "null"]
    },
    "reject_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invalid_type": {
      "type": ["string", "null"]
    },
    "llm_validation_used": {
      "type": "boolean"
    },
    "main_axis_clear": {
      "type": "boolean"
    },
    "answerable": {
      "type": "boolean"
    },
    "external_knowledge_required": {
      "type": "boolean"
    },
    "repeated_pattern_with_previous_round": {
      "type": "boolean"
    },
    "format_difficulty_dominant": {
      "type": "boolean"
    },
    "llm_validation_reason": {
      "type": "string"
    },
    "local_validation_rule_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "local_validation_reused": {
      "type": "boolean"
    }
  }
}
