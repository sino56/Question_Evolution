{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator Candidate Envelope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "operator_id",
    "selected_operator_id",
    "semantic_version",
    "prompt_version",
    "applicability_version",
    "validation_policy_version",
    "recipe_hash",
    "evidence_status",
    "status",
    "ability_axis",
    "ability_axes",
    "target_error_taxonomy",
    "target_claim",
    "conclusion_layer",
    "surface_fact_ids",
    "applied_transforms",
    "required_reasoning_output",
    "preserved_parent_obligations",
    "operator_payload",
    "axis_assignments",
    "axis_answer_contracts",
    "axis_interactions",
    "manual_review_record",
    "surface_leakage_risks",
    "answer_contract",
    "answer_contract_resolution"
  ],
  "properties": {
    "operator_id": {"type": "string", "minLength": 1},
    "selected_operator_id": {"type": "string", "minLength": 1},
    "candidate_group_id": {"type": "string"},
    "candidate_id": {"type": "string"},
    "semantic_version": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "applicability_version": {"type": "string", "minLength": 1},
    "validation_policy_version": {"type": "string", "minLength": 1},
    "recipe_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_status": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "enabled",
        "disabled",
        "validation_only",
        "qualification_only",
        "shadow_routing",
        "suspended",
        "retired"
      ]
    },
    "ability_axis": {"type": "string", "minLength": 1},
    "ability_axes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "target_error_taxonomy": {
      "type": "array",
      "items": {"type": "string"}
    },
    "target_claim": {},
    "conclusion_layer": {"type": "string", "minLength": 1},
    "surface_fact_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "applied_transforms": {
      "type": "array",
      "items": {"type": "string"}
    },
    "required_reasoning_output": {
      "type": "array",
      "items": {"type": "string"}
    },
    "preserved_parent_obligations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "operator_payload": {
      "type": "object",
      "additionalProperties": true
    },
    "source_fact_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "axis_assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "axis_id",
          "semantic_ability_axis",
          "source_fact_ids",
          "target_claim",
          "operator_payload",
          "answer_contract_id",
          "rubric_item_ids"
        ],
        "properties": {
          "axis_id": {"type": "string", "minLength": 1},
          "semantic_ability_axis": {"type": "string", "minLength": 1},
          "source_fact_ids": {"type": "array", "items": {"type": "string"}},
          "target_claim": {},
          "operator_payload": {"type": "object", "additionalProperties": true},
          "answer_contract_id": {"type": "string", "minLength": 1},
          "rubric_item_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "axis_interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "source_axis_id",
          "target_axis_id",
          "relation",
          "interaction_contract_id"
        ]
      }
    },
    "axis_answer_contracts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "answer_contract_version",
          "answer_contract_hash",
          "operator_id",
          "recipe_hash",
          "target_claim",
          "conclusion_layer",
          "answer_key",
          "decisive_fact_ids",
          "operator_answer",
          "frozen"
        ]
      }
    },
    "manual_review_record": {
      "type": "object",
      "additionalProperties": true
    },
    "adapter_version": {"type": "string"},
    "surface_leakage_risks": {
      "type": ["object", "array"]
    },
    "answer_contract": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "answer_contract_version",
        "answer_contract_hash",
        "operator_id",
        "recipe_hash",
        "target_claim",
        "conclusion_layer",
        "answer_key",
        "decisive_fact_ids",
        "operator_answer",
        "frozen"
      ],
      "properties": {
        "answer_contract_version": {"const": "answer_contract_v2"},
        "answer_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "operator_id": {"type": "string"},
        "recipe_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_claim": {},
        "conclusion_layer": {"type": "string"},
        "answer_key": {},
        "decisive_fact_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "operator_answer": {
          "type": "object",
          "additionalProperties": true
        },
        "frozen": {"const": true}
      }
    },
    "answer_contract_resolution": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["resolved", "conflict", "generator_only_legacy"]
        },
        "required": {"type": "boolean"},
        "blind_solver_result_hash": {"type": "string"},
        "agreement_fields": {
          "type": "array",
          "items": {"type": "string"}
        },
        "conflict_fields": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
