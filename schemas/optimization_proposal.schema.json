{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline Global Judge Optimization Proposal",
  "type": "object",
  "required": ["record_type", "proposal_version", "proposal_id", "source_evidence_pack", "diagnosis_level", "summary", "recommended_change", "affected_scope", "evidence_strength", "risk", "status", "evidence_refs", "verification_plan", "publish_gate", "rollback_conditions"],
  "properties": {
    "record_type": {"const": "optimization_proposal"},
    "proposal_version": {"const": "global-judge-proposal-v1"},
    "diagnosis_level": {"enum": ["sample/data", "router", "operator selection", "operator generation", "validation", "rubric/judge", "memory", "search/cost"]},
    "evidence_strength": {"enum": ["low", "medium", "high"]},
    "status": {"enum": ["proposed", "needs_human_review", "shadow", "rejected_insufficient_evidence", "active"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "publish_gate": {"type": "object"},
    "rollback_conditions": {"type": "array", "minItems": 1}
  }
}
