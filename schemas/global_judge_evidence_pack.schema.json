{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Global Judge Evidence Pack",
  "type": "object",
  "required": ["record_type", "evidence_pack_version", "evidence_pack_id", "experiment_dir", "snapshot", "artifacts", "metrics"],
  "properties": {
    "record_type": {"const": "global_judge_evidence_pack"},
    "evidence_pack_version": {"const": "global-judge-evidence-pack-v1"},
    "evidence_pack_id": {"type": "string", "minLength": 1},
    "experiment_dir": {"type": "string", "minLength": 1},
    "snapshot": {"type": "object", "required": ["memory_snapshot_id"], "properties": {"memory_snapshot_id": {"type": "string", "minLength": 1}}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["artifact_ref"]}},
    "metrics": {"type": "object"},
    "branch_records": {"type": "array"},
    "l1_experiment_facts": {"type": "array"},
    "l2_strategy_card_candidates": {"type": "array"},
    "manual_reviews": {"type": "array"}
  },
  "not": {"anyOf": [{"required": ["prompt"]}, {"required": ["reference_answer"]}, {"required": ["rubric"]}, {"required": ["scoring_result"]}, {"required": ["score_prompt"]}]}
}
