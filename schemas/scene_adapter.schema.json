{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question Evolution Scene Adapter Output",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "adapter_id",
    "adapter_version",
    "entities",
    "objects",
    "actions",
    "observation_nodes",
    "source_modalities",
    "time_and_path_constraints",
    "candidate_claims",
    "claim_layer_ceiling",
    "unsupported_claim_types",
    "fact_ids_by_observable"
  ],
  "properties": {
    "adapter_id": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "business_surface": {"type": "string", "minLength": 1},
    "entities": {"type": "array"},
    "objects": {"type": "array"},
    "actions": {"type": "array"},
    "observation_nodes": {"type": "array"},
    "source_modalities": {
      "type": "array",
      "items": {"type": "string"}
    },
    "time_and_path_constraints": {"type": "object"},
    "candidate_claims": {"type": "array"},
    "claim_layer_ceiling": {"type": "string", "minLength": 1},
    "unsupported_claim_types": {
      "type": "array",
      "items": {"type": "string"}
    },
    "allowed_expressions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "fact_ids_by_observable": {"type": "object"}
  },
  "not": {
    "anyOf": [
      {"required": ["selected_operator_id"]},
      {"required": ["operator_payload"]},
      {"required": ["answer_key"]},
      {"required": ["target_error_taxonomy"]}
    ]
  }
}
