{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vertical boundary edge",
  "type": "object",
  "required": ["edge_id", "sample_id", "root_node_id", "parent_node_id", "child_node_id", "operator_id", "depth", "parent_score_rate", "child_score_rate", "edge_delta_score_rate", "root_delta_score_rate", "review_status"],
  "properties": {
    "edge_id": {"type": "string", "minLength": 1},
    "sample_id": {"type": "string", "minLength": 1},
    "root_node_id": {"type": "string", "minLength": 1},
    "parent_node_id": {"type": "string", "minLength": 1},
    "child_node_id": {"type": "string", "minLength": 1},
    "operator_id": {"type": "string", "minLength": 1},
    "depth": {"type": "integer", "minimum": 2},
    "parent_score_rate": {"type": "number"},
    "child_score_rate": {"type": "number"},
    "edge_delta_score_rate": {"type": "number"},
    "root_delta_score_rate": {"type": "number"},
    "boundary_kind": {"enum": ["single_operator", "stacked_operator", null]},
    "review_status": {"enum": ["pending", "approved", "rejected"]}
  },
  "additionalProperties": true
}
